POSTGRES_DB=barbearia_scaquetti
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_password_change_me

PORT=3001
NODE_ENV=development
AUTH_PROVIDER=local

# Local Docker only. Keep these values aligned with POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above.
# For Render/Railway, use the real Supabase PostgreSQL URLs in the host dashboard, never in GitHub.
DATABASE_URL=postgresql://postgres:local_dev_password_change_me@postgres:5432/barbearia_scaquetti?schema=public
DIRECT_URL=postgresql://postgres:local_dev_password_change_me@postgres:5432/barbearia_scaquetti?schema=public

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:4173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Replace-with-a-strong-password-123!
ADMIN_NAME=Administrador
