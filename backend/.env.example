PORT=3001
NODE_ENV=development
AUTH_PROVIDER=local

# Local Docker example only. For Supabase/Render, configure the real URLs in the deploy dashboard.
# Never commit a real Supabase connection string to GitHub.
DATABASE_URL=
DIRECT_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
PRISMA_CLIENT_ENGINE_TYPE=binary

# Usuario principal criado por `npm run seed:admin`.
# ADMIN_EMAIL e ADMIN_PASSWORD sao sempre obrigatorios.
# A senha precisa ter 12+ caracteres, maiuscula, minuscula, numero e caractere especial.
# Senhas padrao conhecidas, como Admin@123, sao bloqueadas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# MVP default: AUTH_PROVIDER=local.
# Supabase should be used only as managed PostgreSQL for this MVP.
